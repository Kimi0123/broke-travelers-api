# Environment Variables Example for Broke Travelers API (Local Development Only)

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Reverse proxy hops for trust proxy (e.g. 1 for single reverse proxy like Render or Cloudflare)
TRUST_PROXY_HOPS=1

# Email verification enforcement policy (true or false, must be explicitly set)
REQUIRE_VERIFIED_EMAIL=false

# Firebase Configuration
FIREBASE_PROJECT_ID=broke-travelers-dev
# Base64 or raw JSON string of a service account; never commit a real one
FIREBASE_SERVICE_ACCOUNT_JSON=

# Port exposed on local host by Docker Compose (maps to 5432 inside container)
# Note: On Windows systems where Hyper-V dynamically reserves 5355-5454, port 5533 is used.
POSTGRES_PORT=5533

# PostgreSQL Superuser (used by Docker Compose container init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_secret
POSTGRES_DB=broke_travelers

# Role Passwords (Local Dev Defaults)
MIGRATION_OWNER_PASSWORD=migration_owner_local_dev_secret
API_USER_PASSWORD=api_user_local_dev_secret

# Development Database URLs
# Runtime application connection string (api_user - least privilege, no DDL)
DATABASE_URL="postgresql://api_user:api_user_local_dev_secret@localhost:5533/broke_travelers?schema=public"

# Migration connection string (migration_owner - schema DDL permissions)
DIRECT_URL="postgresql://migration_owner:migration_owner_local_dev_secret@localhost:5533/broke_travelers?schema=public"

# Test Database URLs (used by integration tests; completely isolated from development data)
TEST_DATABASE_URL="postgresql://api_user:api_user_local_dev_secret@localhost:5533/broke_travelers_test?schema=public"
TEST_DIRECT_URL="postgresql://migration_owner:migration_owner_local_dev_secret@localhost:5533/broke_travelers_test?schema=public"
