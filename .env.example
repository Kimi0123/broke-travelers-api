# Environment Variables Example for Broke Travelers API (Local Development Only)

# Port exposed on local host by Docker Compose (maps to 5432 inside container)
# Note: On Windows systems where Hyper-V dynamically reserves 5355-5454, change to 5533.
POSTGRES_PORT=5433

# PostgreSQL Superuser (used by Docker Compose container init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_secret
POSTGRES_DB=broke_travelers

# Role Passwords (Local Dev Defaults)
MIGRATION_OWNER_PASSWORD=migration_owner_local_dev_secret
API_USER_PASSWORD=api_user_local_dev_secret

# Development Database URLs
# Runtime application connection string (api_user - least privilege, no DDL)
DATABASE_URL="postgresql://api_user:api_user_local_dev_secret@localhost:5433/broke_travelers?schema=public"

# Migration connection string (migration_owner - schema DDL permissions)
DIRECT_URL="postgresql://migration_owner:migration_owner_local_dev_secret@localhost:5433/broke_travelers?schema=public"

# Test Database URLs (used by integration tests; completely isolated from development data)
TEST_DATABASE_URL="postgresql://api_user:api_user_local_dev_secret@localhost:5433/broke_travelers_test?schema=public"
TEST_DIRECT_URL="postgresql://migration_owner:migration_owner_local_dev_secret@localhost:5433/broke_travelers_test?schema=public"
